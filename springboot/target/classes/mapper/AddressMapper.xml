<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.springboot.mapper.AddressMapper">

    <select id="selectAll" resultType="org.example.springboot.entity.Address">
        select * from `address`
        <where>
            <if test="name != null and name != ''">name like concat('%',#{name},'%')</if>
        </where>
        order by id desc
    </select>

    <insert id="insert">
        insert into `address` (name,address,info,phone,user_id)
        values (#{name},#{address},#{info},#{phone},#{userId})
    </insert>

    <update id="update">
        update `address` set name = #{name},address = #{address},info = #{info},phone = #{phone},user_id = #{userId} where id = #{id}
    </update>

    <select id="selectByUserId" resultType="org.example.springboot.entity.Address">
        select *
        from `address`
        where user_id = #{userId}
        order by id desc
    </select>

</mapper>