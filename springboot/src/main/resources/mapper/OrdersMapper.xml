<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.springboot.mapper.OrdersMapper">

    <select id="selectAll" resultType="org.example.springboot.entity.Orders">
        select * from `orders`
        <where>
            <if test="no != null and no != ''">no like concat('%',#{no},'%')</if>
        </where>
        order by id desc
    </select>

    <insert id="insert">
        insert into `orders` (no,goods_id,goods_name,goods_img,from_id,to_id,price,time,status,to_rate,to_review,address,info,name,phone,review_time)
        values (#{no},#{goodsId},#{goodsName},#{goodsImg},#{fromId},#{toId},#{price},#{time},#{status},#{toRate},#{toReview},#{address},#{info},#{name},#{phone},#{reviewTime})
    </insert>

    <update id="update">
        update `orders` set no = #{no} ,goods_id = #{goodsId},goods_name = #{goodsName},goods_img = #{goodsImg},from_id = #{fromId},to_id = #{toId}
                          ,price = #{price},time = #{time},status = #{status},to_rate = #{toRate},to_review = #{toReview},address = #{address}
                          ,info = #{info},name = #{name},phone = #{phone},review_time = #{reviewTime}
                        where id = #{id}
    </update>

    <select id="selectByUserId" resultType="org.example.springboot.entity.Orders">
        select *
        from orders
        <where>

            <!-- 根据 sideBar 判断身份 -->
            <choose>
                <when test="sideBar == 'SELL'">
                    from_id = #{userId}
                </when>
                <otherwise>
                    to_id = #{userId}
                </otherwise>
            </choose>

            <!-- 状态筛选 -->
            <if test="activeTab != null and activeTab != '' and activeTab != '全部'">
                and status = #{activeTab}
            </if>

            <!-- 订单号搜索 -->
            <if test="keyword != null and keyword != ''">
                and no like concat('%', #{keyword}, '%')
            </if>

        </where>
        order by id desc
    </select>

    <select id="selectComment" resultType="org.example.springboot.entity.Orders">
        SELECT *
        FROM orders
        WHERE from_id = #{userId}
          AND to_rate IS NOT NULL
          AND to_review IS NOT NULL
          AND to_review != ''
        ORDER BY review_time DESC
    </select>

</mapper>