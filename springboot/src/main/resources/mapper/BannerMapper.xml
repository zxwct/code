<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.springboot.mapper.BannerMapper">

    <select id="selectAll" resultType="org.example.springboot.entity.Banner">
        select * from `banner`
        <where>
            <if test="name != null and name != ''">name like concat('%',#{name},'%')</if>
        </where>
        order by id desc
    </select>

    <insert id="insert">
        insert into `banner` (img,name)
        values (#{img},#{name})
    </insert>

    <update id="update">
        update `banner` set img = #{img} ,name = #{name} where id = #{id}
    </update>

</mapper>